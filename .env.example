# ==========================================================
# FLOWPILOT AI - CONFIGURAÇÃO DE AMBIENTE (.env.example)
# Copie este arquivo para .env se desejar usar o Modo LLM.
# O sistema funciona 100% no Modo Local Determinístico sem chaves!
# ==========================================================

# Modo de operação inicial: "LOCAL" ou "LLM"
FLOWPILOT_MODE=LOCAL

# Provedor de LLM: "openai", "gemini" ou "compatible"
LLM_PROVIDER=openai

# Chave de API (NUNCA comite sua chave real no Git)
LLM_API_KEY=

# Modelo padrão a ser utilizado no Modo LLM
LLM_MODEL=gpt-4o-mini

# URL base opcional (para provedores compatíveis com OpenAI / Ollama / vLLM)
LLM_BASE_URL=https://api.openai.com/v1

# Caminho do banco de dados SQLite
FLOWPILOT_DB_PATH=data/flowpilot.db
